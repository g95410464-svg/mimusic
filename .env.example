# ============================================================================
# mimusic · Configuración opcional (.env)
# ============================================================================
# No necesitas crear un archivo .env para usar mimusic en tu computadora o red
# local: `docker compose up -d` funciona directamente con estos valores.
#
# Si deseas personalizar puertos, rutas de música o activar HTTPS con Tailscale,
# copia este archivo a `.env` y ajusta únicamente lo que necesites:
#   cp .env.example .env
# ============================================================================

# Puertos expuestos en tu equipo
PORT=4173
NAVIDROME_PORT=4533

# Carpetas de música en tu equipo (puedes apuntar a tu biblioteca existente)
MUSIC_DIR=./music
DOWNLOADS_DIR=./music/mimusic

# URLs por defecto (modo local / LAN automática)
NAVIDROME_URL=http://navidrome:4533
NAVIDROME_PUBLIC_URL=http://localhost:4533
APP_ORIGIN=http://localhost:4173

# ----------------------------------------------------------------------------
# Opcional: Acceso remoto privado por HTTPS (ej. Tailscale para iPad / iPhone)
# ----------------------------------------------------------------------------
# Si publicas con `tailscale serve`, cambia a tus dominios HTTPS y limita la
# escucha a 127.0.0.1:
# APP_BIND=127.0.0.1
# NAVIDROME_BIND=127.0.0.1
# NAVIDROME_PUBLIC_URL=https://mi-servidor.tailnet.ts.net
# APP_ORIGIN=https://mi-servidor.tailnet.ts.net:8443
